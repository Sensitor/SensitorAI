//+------------------------------------------------------------------+
//| SensitorTests.mq5 - unit & parity tests of the MQL5 engine.       |
//| Expected values are the ones of Tests/python (hand computed) and  |
//| the Python reference outputs in Tests/Fixtures.mqh (generated by  |
//| Research/scripts/gen_mql5_fixtures.py).                           |
//| Result: Experts tab + Common\Files\SensitorAI\tests_result.txt    |
//+------------------------------------------------------------------+
#property script_show_inputs
#property strict

#include <SensitorAI/SignalEngine.mqh>
#include <SensitorAI/RiskManager.mqh>
#include <SensitorAI/NewsFilter.mqh>
#include <SensitorAI/Tests/Fixtures.mqh>

input bool InpCloseTerminal=false;   // close the terminal when done (CI / headless runs)

int    g_pass=0,g_fail=0;
string g_failures="";

void Check(const bool cond,const string name)
  {
   if(cond) g_pass++;
   else { g_fail++; g_failures+=name+"\n"; Print("FAIL: ",name); }
  }
void Near(const double a,const double b,const double tol,const string name)
  {
   bool ok=(a==EMPTY_VALUE && b==EMPTY_VALUE) || MathAbs(a-b)<=tol;
   Check(ok,StringFormat("%s (got %.10g expected %.10g)",name,a,b));
  }

//--- load a fixture into a series
void Fill(CBarSeries &s,const long &t[],const double &o[],const double &h[],const double &l[],const double &c[],const int upto=-1)
  {
   int n=(upto<0) ? ArraySize(t) : upto;
   for(int i=0;i<n;i++) s.Append((datetime)t[i],o[i],h[i],l[i],c[i]);
  }

//--- run the engine over a dataset: HTF loaded entirely (engine reads only closed bars),
//--- entry bars appended one by one exactly like the EA does.
void RunEngine(CSignalEngine &eng,const SConfig &cfg,
               const long &et[],const double &eo[],const double &eh[],const double &el[],const double &ec[],
               const long &t1[],const double &o1[],const double &h1[],const double &l1[],const double &c1[],
               const long &t4[],const double &o4[],const double &h4[],const double &l4[],const double &c4[],
               const double spread,const int n_entry=-1)
  {
   eng.Init(cfg,0.01);
   Fill(eng.h1,t1,o1,h1,l1,c1);
   Fill(eng.h4,t4,o4,h4,l4,c4);
   int n=(n_entry<0) ? ArraySize(et) : n_entry;
   for(int k=0;k<n;k++)
     {
      eng.entry.Append((datetime)et[k],eo[k],eh[k],el[k],ec[k]);
      eng.ProcessEntryBar(k,spread);
     }
  }

//==================================================================== tests
void TestIndicators()
  {
   double h[20],l[20],c[20],a[];
   for(int i=0;i<20;i++) { h[i]=11; l[i]=10; c[i]=10.5; }
   CalcATR(h,l,c,20,14,a);
   Check(a[13]==EMPTY_VALUE,"ATR warm-up");
   Near(a[14],1.0,1e-12,"ATR flat");
   h[15]=13;
   CalcATR(h,l,c,20,14,a);
   Near(a[15],(13*1.0+3.0)/14,1e-12,"ATR wide bar");
   Near(AtrAt(h,l,c,19,14),(13*1.0+3.0)/14,1e-12,"AtrAt incremental");
   //--- RSI
   double up[30];
   for(int i=0;i<30;i++) up[i]=i;
   CRsiCalc r; r.Init(14); r.Update(up,30);
   Check(r.values[13]==EMPTY_VALUE && r.values[14]==100.0 && r.values[29]==100.0,"RSI monotonic up = 100");
   double flat[20]; ArrayInitialize(flat,5.0);
   CRsiCalc r2; r2.Init(14); r2.Update(flat,20);
   Check(r2.values[19]==50.0,"RSI flat = 50");
   double cc[16]; cc[0]=100;
   for(int i=0;i<14;i++) cc[i+1]=cc[i]+((i%2==0) ? 1.0 : -1.0);
   cc[15]=cc[14]+2.0;
   CRsiCalc r3; r3.Init(14);
   r3.Update(cc,15); r3.Update(cc,16);          // incremental extension
   Near(r3.values[14],50.0,1e-12,"RSI seed");
   double pos=(0.5*13+2.0)/14, neg=(0.5*13)/14;
   Near(r3.values[15],100-100/(1+pos/neg),1e-12,"RSI Wilder step (incremental)");
   double w1[]={60,65,69.99,50,55}, w2[]={60,65,70.0,50,55}, w3[]={40,35,30.01,45,50}, w4[]={40,35,30.0,45,50};
   double ex;
   Check(!RsiWindowBlocks(w1,4,5,1,70,30,ex),"RSI 69.99 does not block a buy");
   Check(RsiWindowBlocks(w2,4,5,1,70,30,ex),"RSI 70 blocks a buy");
   Check(!RsiWindowBlocks(w3,4,5,-1,70,30,ex),"RSI 30.01 does not block a sell");
   Check(RsiWindowBlocks(w4,4,5,-1,70,30,ex),"RSI 30 blocks a sell");
  }

void TestSwings()
  {
   double h[]={1,2,5,5,3,2}, l[]={5,4,1,1,3,4};
   Check(IsSwingHigh(h,6,2,2,2) && !IsSwingHigh(h,6,3,2,2),"swing high tie rule");
   Check(IsSwingLow(l,6,2,2,2) && !IsSwingLow(l,6,3,2,2),"swing low tie rule");
   Check(CombineBias(1,1,BIAS_REQUIRE_BOTH)==1 && CombineBias(1,-1,BIAS_REQUIRE_BOTH)==0 &&
         CombineBias(1,0,BIAS_REQUIRE_BOTH)==0 && CombineBias(1,0,BIAS_H4_LEADS)==1 &&
         CombineBias(1,-1,BIAS_H4_LEADS)==0 && CombineBias(0,1,BIAS_H4_LEADS)==0,"bias combination table");
  }

void TestStructure()
  {
   CBarSeries b; b.Init(900);
   for(int i=0;i<11;i++) b.Append((datetime)(FX_T0+i*900),SC_E_o[FX_PREFIX+i],SC_E_h[FX_PREFIX+i],SC_E_l[FX_PREFIX+i],SC_E_c[FX_PREFIX+i]);
   CStructureTracker t; t.Init(GetPointer(b),2,2,0.0,FLIP_ON_CHOCH,30);
   for(int k=0;k<11;k++) t.Update(k);
   int sh=0,sl=0,bu=0;
   for(int i=0;i<ArraySize(t.events);i++)
     {
      if(t.events[i].kind==EV_SWING_HIGH) { sh++; Check(t.events[i].pivot==3 && t.events[i].bar==5 && t.events[i].price==103.0,"swing high @3 confirmed @5"); }
      if(t.events[i].kind==EV_SWING_LOW)  { sl++; Check(t.events[i].pivot==7 && t.events[i].bar==9 && t.events[i].price==99.0,"swing low @7 confirmed @9"); }
      if(t.events[i].kind==EV_BREAK_UP)   { bu++; Check(t.events[i].bar==10 && t.events[i].price==103.0 && t.events[i].label=="BOS","BOS @10"); }
     }
   Check(sh==1 && sl==1 && bu==1,"structure event counts");
   Check(t.trend==SAI_BULL && !t.ref_high.valid,"trend bull, reference consumed");
   //--- wick beyond the level without close = sweep, not break
   CBarSeries b2; b2.Init(900);
   for(int i=0;i<9;i++) b2.Append((datetime)(FX_T0+i*900),SC_E_o[FX_PREFIX+i],SC_E_h[FX_PREFIX+i],SC_E_l[FX_PREFIX+i],SC_E_c[FX_PREFIX+i]);
   b2.Append((datetime)(FX_T0+9*900),100.9,103.5,100.8,102.9);
   CStructureTracker t2; t2.Init(GetPointer(b2),2,2,0.0,FLIP_ON_CHOCH,30);
   for(int k=0;k<10;k++) t2.Update(k);
   bool brk=false,swp=false;
   for(int i=0;i<ArraySize(t2.events);i++)
     {
      if(t2.events[i].kind==EV_BREAK_UP) brk=true;
      if(t2.events[i].kind==EV_SWEEP_HIGH && t2.events[i].bar==9 && t2.events[i].price==103.0) swp=true;
     }
   Check(!brk && swp && t2.ref_high.valid && ArraySize(t2.liq_highs)==0,"wick = sweep, not a break");
  }

void TestZones()
  {
   SZone z=OteZone(1,2000,2010,0.62,0.79);
   Near(z.low,2002.10,1e-9,"OTE buy low"); Near(z.high,2003.80,1e-9,"OTE buy high");
   z=OteZone(-1,2000,2010,0.62,0.79);
   Near(z.low,2006.20,1e-9,"OTE sell low"); Near(z.high,2007.90,1e-9,"OTE sell high");
   double fh[]={10.0,12.0,13.0,14.0}, fl[]={9.0,10.5,12.5,13.5};
   SZone f[];
   Check(FindFvgs(1,fh,fl,0,3,0.0,f)==2 && f[0].low==10.0 && f[0].high==12.5 && f[0].index==1 && f[1].low==12.0 && f[1].high==13.5,"FVG bullish");
   double oo[]={10.0,10.5,10.2,10.1,10.6}, oc[]={10.5,10.2,10.1,10.6,12.0}, oh[]={10.6,10.6,10.3,10.7,12.1}, ol[]={9.9,10.1,9.8,10.0,10.5};
   SZone ob=FindOrderBlock(1,oo,oh,ol,oc,4,2,5,2,OB_ZONE_WICK);
   Check(ob.valid && ob.index==2 && ob.low==9.8 && ob.high==10.3,"OB last bearish candle");
   ob=FindOrderBlock(1,oo,oh,ol,oc,4,2,5,2,OB_ZONE_BODY);
   Check(ob.low==10.1 && ob.high==10.2,"OB body");
   Check(!FindOrderBlock(1,oo,oh,ol,oc,4,3,0,0,OB_ZONE_WICK).valid,"OB none in window");
   SZone ote; ote.Set(100.0,101.0,-1);
   SZone a; a.Set(100.2,100.6,0); SZone bz; bz.Set(99.5,100.4,0); SZone cz; cz.Set(98.0,99.9,0);
   SZone ia=Intersect(a,ote), ib=Intersect(bz,ote), ic=Intersect(cz,ote);
   Check(ia.valid && ia.low==100.2 && ia.high==100.6 && IsInside(a,ote),"case A");
   Check(ib.valid && ib.low==100.0 && ib.high==100.4 && !IsInside(bz,ote),"case B");
   Check(!ic.valid,"no overlap");
   SZone zz; zz.Set(100.0,100.4,0);
   double e;
   EntryPrice(1,zz,0.0,0.01,e);  Near(e,100.40,1e-9,"entry buy depth 0");
   EntryPrice(1,zz,0.5,0.01,e);  Near(e,100.20,1e-9,"entry buy depth .5");
   EntryPrice(1,zz,1.0,0.01,e);  Near(e,100.00,1e-9,"entry buy depth 1");
   EntryPrice(-1,zz,0.0,0.01,e); Near(e,100.00,1e-9,"entry sell depth 0");
   EntryPrice(-1,zz,1.0,0.01,e); Near(e,100.40,1e-9,"entry sell depth 1");
   SZone narrow; narrow.Set(100.003,100.008,0);
   Check(!EntryPrice(1,narrow,0.5,0.01,e),"zone narrower than a tick");
   SZone one; one.Set(100.004,100.016,0);
   EntryPrice(1,one,0.0,0.01,e); Near(e,100.01,1e-9,"entry clamped inside");
   SZone obz; obz.Set(99.2,100.6,0);
   Near(StopLossPrice(1,obz,99.0,105.5,SL_STRUCTURAL,0.1,0.01,0),98.90,1e-9,"SL structural");
   Near(StopLossPrice(1,obz,99.0,105.5,SL_OB_DISTAL,0.1,0.01,0),99.10,1e-9,"SL OB distal");
   Near(StopLossPrice(1,obz,99.0,105.5,SL_STRUCTURAL,0.105,0.01,0),98.89,1e-9,"SL rounding away");
   SZone obs; obs.Set(104.0,105.2,0);
   Near(StopLossPrice(-1,obs,99.0,105.5,SL_STRUCTURAL,0.1,0.01,0.05),105.65,1e-9,"SL sell + spread");
   //--- zone states
   double zh[]={105,105,105,105,105,105}, zl[]={103,102,102,102,102,102}, zc[]={104,104,104,104,104,104};
   SZone dz; dz.Set(100.0,101.0,0);
   Check(ZoneState(1,dz,zh,zl,zc,0,5)==ZONE_VALID,"zone valid");
   zl[3]=100.5; Check(ZoneState(1,dz,zh,zl,zc,0,5)==ZONE_PARTIALLY_MITIGATED,"zone partial");
   zl[4]=100.0; Check(ZoneState(1,dz,zh,zl,zc,0,5)==ZONE_FULLY_MITIGATED,"zone full");
   zc[5]=99.9;  Check(ZoneState(1,dz,zh,zl,zc,0,5)==ZONE_INVALIDATED,"zone invalidated");
  }

void TestRisk()
  {
   string r;
   Near(ComputeVolume(100,500,0,0.01,0.01,100,0,r),0.20,1e-9,"volume 0.20");
   Near(ComputeVolume(100,500,7,0.01,0.01,100,0,r),0.19,1e-9,"volume with commission 0.19");
   Near(ComputeVolume(100,333,0,0.01,0.01,100,0,r),0.30,1e-9,"volume never rounds up");
   Check(ComputeVolume(5,600,0,0.01,0.01,100,0,r)==0 && r=="REJECT_MIN_LOT_EXCEEDS_RISK","min lot refused");
   Near(ComputeVolume(1e6,100,0,0.01,0.01,50,20,r),20,1e-9,"volume limit");
   string a;
   Near(PartialCloseVolume(0.20,0.20,0.5,0.01,0.01,PARTIAL_FB_CLOSE_ALL,a),0.10,1e-9,"partial 0.10"); Check(a=="PARTIAL","partial action");
   Near(PartialCloseVolume(0.15,0.15,0.5,0.01,0.01,PARTIAL_FB_CLOSE_ALL,a),0.07,1e-9,"partial 0.07");
   Near(PartialCloseVolume(0.01,0.01,0.5,0.01,0.01,PARTIAL_FB_CLOSE_ALL,a),0.01,1e-9,"partial fallback close all"); Check(a=="FALLBACK_CLOSE_ALL","fallback action");
   Near(PartialCloseVolume(0.01,0.01,0.5,0.01,0.01,PARTIAL_FB_KEEP_ALL,a),0.0,1e-9,"partial fallback keep");
   Near(RMultiple(1,100,99,103),3.0,1e-12,"R buy"); Near(RMultiple(-1,100,101,97),3.0,1e-12,"R sell");
   Check(TighterSL(1,99.0,99.5) && !TighterSL(1,99.5,99.0) && TighterSL(-1,101.0,100.5) && !TighterSL(-1,100.5,101.0),"SL never widened");
  }

void TestNews()
  {
   datetime ev[]; ArrayResize(ev,1); ev[0]=D'2024.01.05 15:30';
   int w;
   Check(CNewsFilter::InWindow(D'2024.01.05 15:00',ev,30,30,w),"news window start");
   Check(CNewsFilter::InWindow(D'2024.01.05 16:00',ev,30,30,w),"news window end");
   Check(!CNewsFilter::InWindow(D'2024.01.05 14:59',ev,30,30,w),"news before window");
   Check(!CNewsFilter::InWindow(D'2024.01.05 16:01',ev,30,30,w),"news after window");
  }

//--- the hand-built scenario (expected values in Tests/python/synth.py)
void TestEngineScenario()
  {
   SConfig c=ConfigDefaults();
   c.rsi_mode=RSI_OFF; c.sl_buffer_points=10; c.sl_buffer_atr=0.0; c.caution_sweep_action=SWEEP_LOG_ONLY; c.entry_depth=0.5;
   CSignalEngine eng;
   RunEngine(eng,c,SC_E_t,SC_E_o,SC_E_h,SC_E_l,SC_E_c,SC_H1_t,SC_H1_o,SC_H1_h,SC_H1_l,SC_H1_c,SC_H4_t,SC_H4_o,SC_H4_h,SC_H4_l,SC_H4_c,0.05);
   Check(ArraySize(eng.setups)==1,"scenario: one setup");
   if(ArraySize(eng.setups)!=1) return;
   SSetup s=eng.setups[0];
   int P=FX_PREFIX;
   Check(s.direction==1 && s.status==SETUP_STATUS_VALID,"scenario: valid buy");
   Check(s.break_bar==P+10 && s.break_label=="BOS" && s.broken_level==103.0,"scenario: BOS");
   Check(s.confirm_bar==P+14 && s.origin_idx==P+7 && s.origin_price==99.0 && s.extreme_idx==P+12 && s.extreme_price==105.5,"scenario: impulse");
   Near(s.ote_low,100.365,1e-9,"scenario: OTE low"); Near(s.ote_high,101.47,1e-9,"scenario: OTE high");
   Check(s.fvg_low==100.6 && s.fvg_high==100.8 && s.ob_low==99.0 && s.ob_high==100.6 && s.ob_idx==P+7,"scenario: OB/FVG");
   Check(s.entry_case=="B","scenario: case B");
   Near(s.entry,100.48,1e-9,"scenario: entry"); Near(s.sl,98.90,1e-9,"scenario: SL"); Near(s.risk_dist,1.58,1e-9,"scenario: 1R");
   Check(s.place_bar==P+14 && s.tp_liquidity_is_fallback,"scenario: placed, liquidity fallback");
   Near(s.tp_liquidity,100.48+6*1.58,1e-9,"scenario: liquidity target");
  }

//--- field-by-field parity with the Python engine on random data
void CheckParity(CSignalEngine &eng,const int si,const int ci,const int n,const string &id[],const string &status[],
                 const string &reason[],const string &end_reason[],const int &confirm_bar[],const int &place_bar[],
                 const int &end_bar[],const int &ob_idx[],const int &fvg_mid[],const double &entry[],const double &sl[],
                 const double &ote_low[],const double &ote_high[],const double &ob_low[],const double &ob_high[],
                 const double &fvg_low[],const double &fvg_high[],const double &tp_liq[],const double &risk[])
  {
   string tag=StringFormat("parity seed%d cfg%d",si,ci);
   Check(ArraySize(eng.setups)==n,StringFormat("%s: setup count %d vs %d",tag,ArraySize(eng.setups),n));
   int m=MathMin(n,ArraySize(eng.setups));
   int bad=0;
   for(int i=0;i<m;i++)
     {
      SSetup s=eng.setups[i];
      string st=(s.status==SETUP_STATUS_VALID ? "SETUP_VALID" : s.status==SETUP_STATUS_REJECTED ? "REJECTED" :
                 s.status==SETUP_STATUS_MISSED ? "MISSED" : "INVALIDATED");
      bool ok=(s.id==id[i] && st==status[i] && s.reason==reason[i] && s.end_reason==end_reason[i] &&
               s.confirm_bar==confirm_bar[i] && s.place_bar==place_bar[i] && s.end_bar==end_bar[i]);
      if(status[i]!="REJECTED" || reason[i]=="REJECT_RSI" || reason[i]=="REJECT_CAUTION_SWEEP" || reason[i]=="REJECT_SL_TOO_TIGHT")
        {
         ok=ok && s.ob_idx==ob_idx[i] && s.fvg_mid_idx==fvg_mid[i];
         ok=ok && MathAbs(s.entry-entry[i])<1e-6 && MathAbs(s.sl-sl[i])<1e-6;
         ok=ok && MathAbs(s.ote_low-ote_low[i])<1e-6 && MathAbs(s.ote_high-ote_high[i])<1e-6;
         ok=ok && MathAbs(s.ob_low-ob_low[i])<1e-9 && MathAbs(s.ob_high-ob_high[i])<1e-9;
         ok=ok && MathAbs(s.fvg_low-fvg_low[i])<1e-9 && MathAbs(s.fvg_high-fvg_high[i])<1e-9;
         ok=ok && MathAbs(s.risk_dist-risk[i])<1e-6;
         ok=ok && ((s.tp_liquidity==EMPTY_VALUE && tp_liq[i]==EMPTY_VALUE) || MathAbs(s.tp_liquidity-tp_liq[i])<1e-6);
        }
      if(!ok)
        {
         bad++;
         if(bad<=5) PrintFormat("%s mismatch #%d: mql5[%s %s %s end=%s cb=%d pb=%d eb=%d E=%.5f SL=%.5f] py[%s %s %s end=%s cb=%d pb=%d eb=%d E=%.5f SL=%.5f]",
                                tag,i,s.id,st,s.reason,s.end_reason,s.confirm_bar,s.place_bar,s.end_bar,s.entry,s.sl,
                                id[i],status[i],reason[i],end_reason[i],confirm_bar[i],place_bar[i],end_bar[i],entry[i],sl[i]);
        }
     }
   Check(bad==0,StringFormat("%s: %d/%d setups differ",tag,bad,m));
  }

#define RUN_PARITY(SI,CI) \
   { CSignalEngine e##SI##CI; SConfig c##SI##CI=ParityConfig##CI(); \
     RunEngine(e##SI##CI,c##SI##CI,PD##SI##_E_t,PD##SI##_E_o,PD##SI##_E_h,PD##SI##_E_l,PD##SI##_E_c, \
               PD##SI##_H1_t,PD##SI##_H1_o,PD##SI##_H1_h,PD##SI##_H1_l,PD##SI##_H1_c, \
               PD##SI##_H4_t,PD##SI##_H4_o,PD##SI##_H4_h,PD##SI##_H4_l,PD##SI##_H4_c,FX_SPREAD); \
     CheckParity(e##SI##CI,SI,CI,EX##SI##_##CI##_N,EX##SI##_##CI##_id,EX##SI##_##CI##_status,EX##SI##_##CI##_reason, \
                 EX##SI##_##CI##_end_reason,EX##SI##_##CI##_confirm_bar,EX##SI##_##CI##_place_bar,EX##SI##_##CI##_end_bar, \
                 EX##SI##_##CI##_ob_idx,EX##SI##_##CI##_fvg_mid_idx,EX##SI##_##CI##_entry,EX##SI##_##CI##_sl, \
                 EX##SI##_##CI##_ote_low,EX##SI##_##CI##_ote_high,EX##SI##_##CI##_ob_low,EX##SI##_##CI##_ob_high, \
                 EX##SI##_##CI##_fvg_low,EX##SI##_##CI##_fvg_high,EX##SI##_##CI##_tp_liquidity,EX##SI##_##CI##_risk_dist); }

void TestParity()
  {
   RUN_PARITY(0,0) RUN_PARITY(0,1) RUN_PARITY(0,2)
   RUN_PARITY(1,0) RUN_PARITY(1,1) RUN_PARITY(1,2)
  }

void OnStart()
  {
   ulong t0=GetMicrosecondCount();
   TestIndicators();
   TestSwings();
   TestStructure();
   TestZones();
   TestRisk();
   TestNews();
   TestEngineScenario();
   TestParity();
   string summary=StringFormat("SensitorTests %s: %d passed, %d failed (%.1f s)",SAI_VERSION,g_pass,g_fail,(GetMicrosecondCount()-t0)/1e6);
   Print(summary);
   FolderCreate("SensitorAI",FILE_COMMON);
   int h=FileOpen("SensitorAI\\tests_result.txt",FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_COMMON);
   if(h!=INVALID_HANDLE) { FileWriteString(h,summary+"\n"+g_failures); FileClose(h); }
   if(InpCloseTerminal) TerminalClose(g_fail==0 ? 0 : 1);
  }
//+------------------------------------------------------------------+
